{
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "trailingComma": "none",
  "embeddedLanguageFormatting": "off",
  "htmlWhitespaceSensitivity": "ignore",
  "plugins": ["@prettier/plugin-php"],
  "overrides": [{ "files": "*.php", "options": { "tabWidth": 4, "phpVersion": "8.4" } }]
}
