{
  "name": "chezvoust-pro-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "ng serve --host 127.0.0.1",
    "start:mock": "ng serve --host 127.0.0.1 --configuration mock",
    "build": "ng build",
    "lint": "eslint src",
    "test": "npm run test:unit && npm run test:structure",
    "test:unit": "node --experimental-strip-types --test tests/availability.spec.ts",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-lines=100 --test tests/availability.spec.ts",
    "test:structure": "node ../tests/structure.mjs",
    "check": "npm run lint && npm run build && npm test",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/common": "20.3.29",
    "@angular/compiler": "20.3.29",
    "@angular/core": "20.3.29",
    "@angular/forms": "20.3.29",
    "@angular/platform-browser": "20.3.29",
    "@angular/router": "20.3.29",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.34",
    "@angular/cli": "20.3.34",
    "@angular/compiler-cli": "20.3.29",
    "@angular-eslint/eslint-plugin": "22.1.0",
    "@angular-eslint/eslint-plugin-template": "22.1.0",
    "@angular-eslint/template-parser": "22.1.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.68.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "lmdb@3.4.2": true,
    "msgpackr-extract@3.0.4": true
  }
}
