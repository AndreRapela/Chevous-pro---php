log_format chezvoust_access '$remote_addr - $remote_user [$time_local] '
                           '"$request_method $uri $server_protocol" $status $body_bytes_sent "$http_user_agent"';

map $uri $site_referrer_policy {
    default strict-origin-when-cross-origin;
    ~^/(?:redefinir-senha|verificar-email)(?:/|$) no-referrer;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    access_log /var/log/nginx/access.log chezvoust_access;
    # Permite mídia de campanha de 25 MiB com folga para multipart.
    client_max_body_size 27m;
    client_body_timeout 60s;

    # O DNS interno do Docker pode mudar o IP da API após uma recriação.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream ${API_PROXY_TARGET};
    set $ssr_upstream ${SSR_UPSTREAM};

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    # Arquivos de descoberta ficam na raiz do domínio, como os rastreadores esperam.
    location = /robots.txt {
        proxy_pass $api_upstream/api/v1/seo/robots.txt;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Proxy-Secret ${PROXY_SHARED_SECRET};
    }

    location = /sitemap.xml {
        proxy_pass $api_upstream/api/v1/seo/sitemap.xml;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Proxy-Secret ${PROXY_SHARED_SECRET};
    }

    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Proxy-Secret ${PROXY_SHARED_SECRET};
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    # A página inicial precisa atravessar o SSR; arquivos estáticos continuam
    # sendo atendidos diretamente pelo Nginx.
    location = / {
        try_files /__never_exists__ @ssr;
    }

    # Áreas pessoais e formulários não podem entrar no índice, mesmo se uma
    # ferramenta ignorar a tag HTML renderizada pelo cliente.
    location ~ ^/(?:entrar|cadastro|recuperar-senha|redefinir-senha|verificar-email|agendar|conta|prestador|admin)(?:/|$) {
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Referrer-Policy $site_referrer_policy always;
        try_files $uri @ssr;
    }

    location / {
        try_files $uri @ssr;
    }

    location ~* \.(?:js|css|woff2?)$ {
        try_files $uri =404;
        gzip on;
        gzip_types application/javascript text/javascript text/css;
        gzip_vary on;
        gzip_min_length 1024;
        gzip_comp_level 5;
        gzip_proxied any;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' https: data: blob:; media-src 'self' https: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; style-src-attr 'none'; script-src 'self'; connect-src 'self'" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    location ~* ^(?!/api/).*\.(?:webp|avif|png|jpe?g|svg)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' https: data: blob:; media-src 'self' https: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; style-src-attr 'none'; script-src 'self'; connect-src 'self'" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    location = /index.html {
        add_header Cache-Control "no-store";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' https: data: blob:; media-src 'self' https: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; style-src-attr 'none'; script-src 'self'; connect-src 'self'" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }

    location @ssr {
        proxy_pass $ssr_upstream;
        proxy_http_version 1.1;
        proxy_hide_header Referrer-Policy;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # The SSR trusts only the overwritten host/protocol headers. Untrusted
        # forwarded headers force Angular to fall back to an empty CSR shell.
        # Client IP has a separate, proxy-overwritten channel below.
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Uri "";
        # Não encaminhe a cadeia enviada pelo cliente: o SSR só recebe o IP
        # observado por este proxy e o autentica de volta na API.
        proxy_set_header X-Client-IP $remote_addr;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
    }

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy $site_referrer_policy always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' https: data: blob:; media-src 'self' https: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; style-src-attr 'none'; script-src 'self'; connect-src 'self'" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
}
