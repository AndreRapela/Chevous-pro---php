APP_ENV=local
APP_DEBUG=true
APP_NAME="ChezVoust Pro"
APP_URL=http://localhost:4200
FRONTEND_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt-BR
APP_CURRENCY=BRL

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chezvoust_pro
DB_USERNAME=chezvoust
DB_PASSWORD=change-me-locally

JWT_SECRET=replace-with-at-least-32-random-characters
PROXY_SHARED_SECRET=replace-with-an-independent-32-character-secret
OUTBOX_ENCRYPTION_KEY=replace-with-an-independent-64-character-outbox-key
JWT_ISSUER=chezvoust-pro-api
JWT_AUDIENCE=chezvoust-pro-web
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
REFRESH_COOKIE_SECURE=false

RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW=60
CHAT_EVENTS_PER_USER=30
CHAT_EVENTS_PER_IP=360
CONVERSATIONS_PER_USER=24
CONVERSATIONS_PER_IP=240
UPLOAD_MAX_BYTES=5242880
MAIL_DRIVER=log
