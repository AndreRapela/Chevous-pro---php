.env
.env.*
.git
.gitignore
*.log
*.dump
*.sql.gz
backup.sql
*.backup.sql

storage/cache/*
!storage/cache/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
storage/rate-limits/*
!storage/rate-limits/.gitkeep
storage/uploads/*
!storage/uploads/.gitkeep
!storage/uploads/private/
storage/uploads/private/*
!storage/uploads/private/.gitkeep
